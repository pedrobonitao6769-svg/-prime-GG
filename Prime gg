local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local espAtivo = false
local highlights = {}

local function limparESP()
	for _, h in pairs(highlights) do
		if h then
			h:Destroy()
		end
	end
	highlights = {}
end

local function ehInocente(player)
	local char = player.Character
	if not char then return false end

	-- Se NÃO tiver Knife nem Gun = inocente
	if char:FindFirstChild("Knife") or player.Backpack:FindFirstChild("Knife") then
		return false
	end
	
	if char:FindFirstChild("Gun") or player.Backpack:FindFirstChild("Gun") then
		return false
	end

	return true
end

local function aplicarESP()
	for _, player in pairs(Players:GetPlayers()) do
		if player ~= Players.LocalPlayer then
			if ehInocente(player) then
				if player.Character and not highlights[player] then
					
					local highlight = Instance.new("Highlight")
					highlight.FillColor = Color3.fromRGB(0, 255, 0) -- verde
					highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
					highlight.FillTransparency = 0.5
					highlight.Parent = player.Character

					highlights[player] = highlight
				end
			else
				-- Se deixou de ser inocente, remove
				if highlights[player] then
					highlights[player]:Destroy()
					highlights[player] = nil
				end
			end
		end
	end
end

-- Loop
RunService.RenderStepped:Connect(function()
	if espAtivo then
		aplicarESP()
	end
end)

