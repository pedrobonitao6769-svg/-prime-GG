local espAtivo = false
local highlightGun = nil

local function limparESP()
	if highlightGun then
		highlightGun:Destroy()
		highlightGun = nil
	end
end

local function pegarGunDrop()
	for _, obj in pairs(Workspace:GetDescendants()) do
		-- Procura pela arma dropada
		if obj.Name == "GunDrop" or obj.Name == "Gun" then
			if obj:IsA("Part") or obj:IsA("Model") then
				return obj
			end
		end
	end
	return nil
end

local function aplicarESP()
	local gun = pegarGunDrop()

	if gun then
		if not highlightGun or highlightGun.Parent ~= gun then
			limparESP()

			local highlight = Instance.new("Highlight")
			highlight.FillColor = Color3.fromRGB(255, 255, 0) -- amarelo
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.2
			highlight.Parent = gun

			highlightGun = highlight
		end
	end
end

-- Loop
RunService.RenderStepped:Connect(function()
	if espAtivo then
		aplicarESP()
	end
end)

