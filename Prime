-- ⚙️ CONFIG FÁCIL DE AJUSTAR
local SETTINGS = {
    TeleportDelay = 0.35, -- ⏱️ tempo entre cada moeda (anti-kick principal)
    LoopPause = 1.2,      -- 🔁 pausa entre ciclos completos
    MaxCoins = 12         -- 🔢 limite de moedas por ciclo
}

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function farmCoins()
    while autofarm do
        pcall(function()
            local root = getRoot()
            local count = 0

            for _, coin in pairs(workspace:GetDescendants()) do
                if not autofarm then break end

                if coin.Name == "Coin" or coin.Name == "Coin_Server" then
                    if coin:IsA("BasePart") then
                        
                        -- TP na moeda
                        root.CFrame = coin.CFrame + Vector3.new(0,2,0)
                        count += 1
                        
                        -- ⏱️ DELAY ENTRE MOEDAS
                        task.wait(SETTINGS.TeleportDelay)

                        -- 🔢 LIMITE POR LOOP
                        if count >= SETTINGS.MaxCoins then
                            break
                        end
                    end
                end
            end
        end)

        -- 🔁 PAUSA ENTRE LOOPS
        task.wait(SETTINGS.LoopPause)
    end
end

