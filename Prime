-- TARGET
local function getTarget()
    local closest = nil
    local shortest = math.huge

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("HumanoidRootPart") then
            
            local pos, onScreen = camera:WorldToViewportPoint(v.Character.Head.Position)

            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - circle.Position).Magnitude

                if dist < FOV and dist < shortest then
                    shortest = dist
                    closest = v
                end
            end
        end
    end

    return closest
end

-- AIM COM PREDIÇÃO
local function aimAt(target)
    local head = target.Character:FindFirstChild("Head")
    local root = target.Character:FindFirstChild("HumanoidRootPart")

    if not head or not root then return end

    -- VELOCIDADE DO PLAYER
    local velocity = root.Velocity

    -- POSIÇÃO FUTURA
    local predictedPosition = head.Position + (velocity * PREDICTION)

    -- SUAVIZAÇÃO
    local currentCF = camera.CFrame
    local newCF = CFrame.new(currentCF.Position, predictedPosition)

    camera.CFrame = currentCF:Lerp(newCF, SMOOTH)
end

-- TOGGLE
local Toggle = Tabs.Main:AddToggle("autofarm", 
{
    Title = "Aim Legit Pro+", 
    Description = "aim com FOV + smooth + predição",
    Default = false,
    Callback = function(state)
        aiming = state
        circle.Visible = state

        if state then
            Fluent:Notify({ Title = "Aim ligado", Content = "Predição ativada" })

            aimConnection = RunService.RenderStepped:Connect(function()
                if aiming and holding then
                    local target = getTarget()

                    if target then
                        aimAt(target)
                    end
                end
            end)

        else
            Fluent:Notify({ Title = "Aim desligado", Content = "Desativado" })

            if aimConnection then
                aimConnection:Disconnect()
                aimConnection = nil
            end
        end
    end 
})
