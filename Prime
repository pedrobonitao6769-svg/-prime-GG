-- ==================== VARIÁVEIS ====================
local flingEnabled = false
local connection = nil
local rootPart = nil
local lastTarget = nil

function StartFling()
    flingEnabled = true
    
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    rootPart = character:WaitForChild("HumanoidRootPart")
    
    connection = game:GetService("RunService").Heartbeat:Connect(function()
        if not flingEnabled or not rootPart or not rootPart.Parent then return end
        
        -- Pega o alvo mais próximo
        local target = nil
        local closestDist = 300
        
        for _, plr in ipairs(game.Players:GetPlayers()) do
            if plr \~= player and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (hrp.Position - rootPart.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        target = hrp
                    end
                end
            end
        end
        
        if not target then return end
        lastTarget = target
        
        -- Colisão
        rootPart.CanCollide = false
        if target.Parent and target.Parent:FindFirstChild("HumanoidRootPart") then
            target.Parent.HumanoidRootPart.CanCollide = false
        end
        
        -- Teleporte suave
        local offset = target.CFrame.LookVector * -4 + Vector3.new(0, 3, 0)
        rootPart.CFrame = CFrame.new(target.Position + offset) * CFrame.Angles(0, math.rad(tick() * 500 % 360), 0)
        
        -- Fling Force (mais controlado)
        local bv = Instance.new("BodyVelocity")
        bv.Name = "FlingVelocity"
        bv.MaxForce = Vector3.new(40000, 40000, 40000)
        bv.Velocity = (target.Position - rootPart.Position).Unit * 180 + Vector3.new(0, 60, 0)
        bv.Parent = rootPart
        
        -- Giro forte
        local bav = Instance.new("BodyAngularVelocity")
        bav.Name = "FlingSpin"
        bav.MaxTorque = Vector3.new(40000, 40000, 40000)
        bav.AngularVelocity = Vector3.new(0, 280, math.random(-80, 80))
        bav.Parent = rootPart
        
        -- Limpeza rápida
        game:GetService("Debris"):AddItem(bv, 0.08)
        game:GetService("Debris"):AddItem(bav, 0.08)
    end)
end

function StopFling()
    flingEnabled = false
    if connection then
        connection:Disconnect()
        connection = nil
    end
    
    -- Limpeza completa
    if rootPart then
        for _, v in ipairs(rootPart:GetChildren()) do
            if v.Name == "FlingVelocity" or v.Name == "FlingSpin" then
                v:Destroy()
            end
        end
        rootPart.CanCollide = true
    end
end

